# Run: node scripts/generate-env.mjs --email you@example.com
# The generator writes a private .env and refuses to overwrite an existing one.
# Fill service credentials here in your local editor; never paste them into chat.
NODE_ENV=production
PORT=3000
ADMIN_EMAIL=change-me@example.com
ADMIN_NAME=Arkentech
ADMIN_PASSWORD=GENERATE_ADMIN_PASSWORD
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=0
WORKFLOW_TOKEN=GENERATE_WORKFLOW_TOKEN

# Dedicated application and n8n database roles are created on FIRST startup.
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD
APP_DB_PASSWORD=GENERATE_APP_DB_PASSWORD
N8N_DB_PASSWORD=GENERATE_N8N_DB_PASSWORD
DATABASE_URL=postgresql://freelance_app:GENERATE_APP_DB_PASSWORD@postgres:5432/freelance
N8N_ENCRYPTION_KEY=GENERATE_N8N_ENCRYPTION_KEY

# Optional AI. Set ai_enabled in the dashboard after connecting your key.
# Model must support Responses API structured JSON outputs.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_CALL_LIMIT=50

# Optional outgoing email. Gmail App Password/SMTP supported where enabled by Google.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=

# Optional private Telegram notifications; start a chat with your bot first.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional IMAP: a dedicated mailbox/folder containing permitted platform alerts.
IMAP_HOST=
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
# Exact sender addresses, comma-separated. Copy the verified senders from your emails.
IMAP_ALLOWED_SENDERS=
# Trusted Authentication-Results authserv-id values from your mailbox provider.
IMAP_AUTH_SERVERS=mx.google.com
IMAP_LOOKBACK_DAYS=7

# n8n local access. Keep its editor private; use an SSH tunnel for a VPS.
GENERIC_TIMEZONE=Asia/Kolkata
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# Only needed by the optional public HTTPS reverse-proxy profile.
APP_DOMAIN=
TLS_EMAIL=
