{
  "name": "Freelance Assistant | Discover permitted opportunities",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Discover permitted opportunities\nRead configured, permitted sources; normalize and deduplicate jobs. No marketplace page scraping.\n\n**Setup:** select the saved Header Auth credential **Freelance Assistant API** in the HTTP Request node. It must contain **Authorization** = **Bearer <WORKFLOW_TOKEN>**.\n\nThe URL targets your Netlify API. A queued response means accepted, not completed; inspect Automation Logs for the actual result. The API checks the dashboard workflow pause setting. Save and publish only after configuring and testing.",
        "height": 330,
        "width": 630
      },
      "id": "a81503a8-4bbe-4bb1-a6d1-381fc6ef59ce",
      "name": "Setup and purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -360,
        -420
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 * * * *"
            }
          ]
        }
      },
      "id": "429739d1-3caa-4428-a659-55f5bbf142b6",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -340,
        0
      ]
    },
    {
      "parameters": {},
      "id": "450e9a17-b8a6-4076-ade7-6a26d9872dfc",
      "name": "Manual check",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -340,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://your-site.netlify.app/internal/workflows/discovery/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Idempotency-Key",
              "value": "={{ $workflow.id + \":\" + $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "f9eef2d3-4e72-44d3-a5ed-f4e7b0b08ce0",
      "name": "Run authorized backend workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notesInFlow": true,
      "notes": "Choose the Header Auth credential. Keep backend tokens out of node parameters. Retries reuse the same execution idempotency key."
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Run authorized backend workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual check": {
      "main": [
        [
          {
            "node": "Run authorized backend workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
    "executionTimeout": 420,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveManualExecutions": false,
    "saveExecutionProgress": false
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
