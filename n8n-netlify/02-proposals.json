{
  "name": "Freelance Assistant | Score and prepare proposals",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Score and prepare proposals\nPrepare drafts from eligible full job descriptions. Unsupported submission methods remain blocked.\n\n**Setup:** select the saved Header Auth credential **Freelance Assistant API** in the HTTP Request node. It must contain **Authorization** = **Bearer <WORKFLOW_TOKEN>**.\n\nThe URL targets your Netlify API. A queued response means accepted, not completed; inspect Automation Logs for the actual result. The API checks the dashboard workflow pause setting. Save and publish only after configuring and testing.",
        "height": 330,
        "width": 630
      },
      "id": "3cd9dc23-f72d-4b02-a3e6-25be6f28376f",
      "name": "Setup and purpose",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -360,
        -420
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/10 * * * *"
            }
          ]
        }
      },
      "id": "e92b4b5a-4b5e-40bd-a57e-2ecabb4d5d0c",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -340,
        0
      ]
    },
    {
      "parameters": {},
      "id": "39282a99-596b-4d63-a0d4-4a41f1fec396",
      "name": "Manual check",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -340,
        180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://your-site.netlify.app/internal/workflows/proposals/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Idempotency-Key",
              "value": "={{ $workflow.id + \":\" + $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "bf6dd318-5a4c-4aeb-ad65-380382a7537c",
      "name": "Run authorized backend workflow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        80
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "notesInFlow": true,
      "notes": "Choose the Header Auth credential. Keep backend tokens out of node parameters. Retries reuse the same execution idempotency key."
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Run authorized backend workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual check": {
      "main": [
        [
          {
            "node": "Run authorized backend workflow",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata",
