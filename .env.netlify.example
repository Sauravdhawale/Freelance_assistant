# Copy to .env locally; set runtime values in Netlify with Functions scope.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Arkentech
# Local one-time setup only; remove after npm run setup:netlify succeeds.
ADMIN_PASSWORD=
APP_ORIGIN=https://YOUR-SITE.netlify.app
COOKIE_SECURE=true
WORKFLOW_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_CALL_LIMIT=50
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
IMAP_HOST=
IMAP_PORT=993
IMAP_TLS=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_ALLOWED_SENDERS=
IMAP_AUTH_SERVERS=mx.google.com
IMAP_LOOKBACK_DAYS=7
